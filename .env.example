# Copy to `.env` (repo root, used by docker compose) and/or `backend/.env`
# (used when running the API directly). Never commit real values.

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma separated. Native apps don't need CORS; list web/dev origins only.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Database --------------------------------------------------------------
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=secondbrain
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432
# Used when running the backend outside Docker (docker compose overrides it).
DATABASE_URL=postgresql+asyncpg://secondbrain:secondbrain@localhost:5432/secondbrain

# --- Object storage (Phase 3) ----------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=secondbrain
S3_SECRET_ACCESS_KEY=secondbrain-secret
S3_BUCKET=secondbrain-files
S3_REGION=us-east-1

# --- AI providers (Phase 5+) -----------------------------------------------
# Keys stay on the server; the mobile app never sees them.
AI_PROVIDER=openai                 # openai | anthropic | groq | ollama
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Mobile (read by Expo at build time; public, never put secrets here) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
